---
import AppCard from './AppCard.astro';
import { apps } from '../data/apps';
interface Props { featured?: boolean; }
const { featured = false } = Astro.props;
---
<div
  class:list={['app-carousel', featured && 'app-carousel-featured']}
  role="region"
  aria-label="Quiet Tools apps — swipe or drag in either direction"
>
  <button class="app-carousel-arrow app-carousel-arrow-left" type="button" aria-label="Show previous app">
    <span aria-hidden="true">‹</span>
  </button>
  <div class="app-carousel-window" tabindex="0">
    <div class="app-carousel-track">
      <div class="app-grid">
        {apps.map((app) => <AppCard app={app} featured={featured} />)}
      </div>
      <div class="app-grid app-grid-copy" aria-hidden="true" inert>
        {apps.map((app) => <AppCard app={app} featured={featured} idPrefix="app-copy" />)}
      </div>
    </div>
  </div>
  <button class="app-carousel-arrow app-carousel-arrow-right" type="button" aria-label="Show next app">
    <span aria-hidden="true">›</span>
  </button>
</div>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('.app-carousel').forEach((carousel) => {
    if (carousel.dataset.dragReady) return;
    carousel.dataset.dragReady = 'true';

    const scrollPort = carousel.querySelector<HTMLElement>('.app-carousel-window');
    const track = carousel.querySelector<HTMLElement>('.app-carousel-track');
    if (!track || !scrollPort) return;

    let dragging = false;
    let dragged = false;
    let pointerStart = 0;
    let previousPointer = 0;
    let hovering = false;
    let lastTime = performance.now();
    const autoSpeed = 22;

    const loopWidth = () => track.scrollWidth / 2;

    const centerOnLoop = () => {
      if (!reducedMotion.matches && loopWidth() > 0 && scrollPort.scrollLeft === 0) {
        scrollPort.scrollLeft = loopWidth();
      }
    };

    requestAnimationFrame(centerOnLoop);
    window.addEventListener('load', centerOnLoop, { once: true });

    const keepInLoop = () => {
      if (reducedMotion.matches) return;
      const width = loopWidth();
      if (!width) return;
      if (scrollPort.scrollLeft < width * 0.5) scrollPort.scrollLeft += width;
      if (scrollPort.scrollLeft > width * 1.5) scrollPort.scrollLeft -= width;
    };

    const animate = (time: number) => {
      const elapsed = Math.min(time - lastTime, 50) / 1000;
      lastTime = time;
      const focused = carousel.contains(document.activeElement);
      if (!reducedMotion.matches && !dragging && !hovering && !focused) {
        scrollPort.scrollLeft += autoSpeed * elapsed;
        keepInLoop();
      }
      requestAnimationFrame(animate);
    };
    requestAnimationFrame(animate);

    carousel.addEventListener('mouseenter', () => { hovering = true; });
    carousel.addEventListener('mouseleave', () => { hovering = false; });

    scrollPort.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      dragging = true;
      dragged = false;
      pointerStart = event.clientX;
      previousPointer = event.clientX;
      scrollPort.setPointerCapture(event.pointerId);
      carousel.classList.add('is-dragging');
    });

    scrollPort.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      if (Math.abs(event.clientX - pointerStart) > 5) dragged = true;
      scrollPort.scrollLeft -= event.clientX - previousPointer;
      previousPointer = event.clientX;
      keepInLoop();
      if (dragged) event.preventDefault();
    });

    const stopDragging = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      carousel.classList.remove('is-dragging');
      if (scrollPort.hasPointerCapture(event.pointerId)) scrollPort.releasePointerCapture(event.pointerId);
    };
    scrollPort.addEventListener('pointerup', stopDragging);
    scrollPort.addEventListener('pointercancel', stopDragging);

    scrollPort.addEventListener('click', (event) => {
      if (dragged) {
        event.preventDefault();
        event.stopPropagation();
        dragged = false;
      }
    }, true);

    scrollPort.addEventListener('scroll', keepInLoop, { passive: true });

    carousel.querySelectorAll<HTMLButtonElement>('.app-carousel-arrow').forEach((button) => {
      button.addEventListener('click', () => {
        const card = track.querySelector<HTMLElement>('.app-card');
        const step = (card?.offsetWidth || 280) + 16;
        const direction = button.classList.contains('app-carousel-arrow-left') ? -1 : 1;
        scrollPort.scrollBy({ left: step * direction, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
      });
    });
  });
</script>
