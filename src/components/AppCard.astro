---
import Badge from './Badge.astro';
import type {QuietToolApp} from '../data/apps';
interface Props {app: QuietToolApp;}
const {app} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<article class="app-card" aria-labelledby={`app-${app.slug}`}>
  <div class="app-card-top"><img src={`${base}${app.image}`} alt="" width="72" height="72" loading="lazy" decoding="async" />{app.slug === 'cast-your-line' && app.appStoreUrl ? <a class="cast-app-store-link" href={app.appStoreUrl} target="_blank" rel="noopener"><img class="cast-app-store-badge" src={`${base}assets/app-store-badge.svg`} width="120" height="40" alt={`Download ${app.name} on the App Store`} /></a> : <Badge status={app.status} />}</div>
  <p class="app-category">{app.category}</p><h3 id={`app-${app.slug}`}>{app.name}</h3><p class="tagline">{app.shortTagline}</p><p class="app-description">{app.description}</p>
  <ul class="feature-chips" aria-label={`${app.name} features`}>{app.features.slice(0,3).map(feature => <li>{feature}</li>)}</ul>
  {app.status === 'coming-soon' && <p class="app-availability">Coming soon to the App Store</p>}
  {app.websiteUrl && <a class="text-link app-link" href={app.websiteUrl}>Explore {app.name.replace(' Planner','')} <span aria-hidden="true">↗</span></a>}
</article>

<style>
  .cast-app-store-link{display:inline-flex;flex-shrink:0;border-radius:6px}
  .cast-app-store-link:focus-visible{outline:3px solid #147185;outline-offset:4px}
  .app-card-top .cast-app-store-badge{display:block;width:120px;height:auto;border-radius:0}
</style>
