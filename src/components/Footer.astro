---
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer">
  <div class="footer-brand">
    <img src={`${base}assets/quiet-tools-mark.png`} alt="Quiet Tools logo mark" />
    <div>
      <strong>Quiet Tools</strong>
      <p>Simple apps for useful things.</p>
    </div>
  </div>
  <div class="footer-columns">
    <div>
      <h2>Navigation</h2>
      <a href={`${base}apps/`}>Apps</a>
      <a href={`${base}support/`}>Support</a>
      <a href={`${base}privacy/`}>Privacy</a>
    </div>
    <div>
      <h2>Company</h2>
      <p>Quiet Tools</p>
      <p>Independent app studio</p>
      <p>quiettoolsapps.com</p>
    </div>
    <div>
      <h2>Stay in touch</h2>
      <p>Questions, feedback, or support for any Quiet Tools app.</p>
      <a href="mailto:support@quiettoolsapps.com">support@quiettoolsapps.com</a>
    </div>
  </div>
  <p class="copyright">© {new Date().getFullYear()} Quiet Tools. All rights reserved.</p>
</footer>
