---
const links = [
  { href: '/apps/', label: 'Apps' },
  { href: '/support/', label: 'Support' },
  { href: '/privacy/', label: 'Privacy' },
];
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Quiet Tools home">
    <img src="/assets/quiet-tools-mark.png" alt="" class="brand-mark" />
    <span>Quiet Tools</span>
  </a>
  <nav class="site-nav" aria-label="Main navigation">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a class="nav-button" href="/apps/">View our apps</a>
  </nav>
</header>
