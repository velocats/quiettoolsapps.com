---
const base = import.meta.env.BASE_URL;
const links = [{href: `${base}apps/`, label: 'Apps'}, {href: `${base}about/`, label: 'About'}, {href: `${base}support/`, label: 'Support'}];
const current = Astro.url.pathname;
---
<header class="site-header">
  <a class="brand" href={base} aria-label="Quiet Tools home"><img src={`${base}assets/optimized/quiet-tools-mark.webp`} width="44" height="44" alt="" /><span>Quiet Tools</span></a>
  <nav class="site-nav" aria-label="Main navigation">{links.map(link => <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>{link.label}</a>)}<a class="nav-button" href={`${base}apps/`}>View apps <span aria-hidden="true">↗</span></a></nav>
  <details class="mobile-menu"><summary>Menu <span aria-hidden="true">+</span></summary><nav aria-label="Mobile navigation">{links.map(link => <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>{link.label}</a>)}<a href={`${base}privacy/`}>Privacy</a></nav></details>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  document.addEventListener('keydown', event => { if(event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
</script>
