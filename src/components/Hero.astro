---
import Button from './Button.astro';
import {apps} from '../data/apps';
const base = import.meta.env.BASE_URL;
---
<section class="hero section-pad" aria-labelledby="home-hero-title">
  <div class="hero-copy"><p class="section-eyebrow"><span class="accent-dot" aria-hidden="true"></span> An independent app studio</p><h1 id="home-hero-title">Useful apps.<br />A little less noise.</h1><p class="hero-subtitle">A home for your hobbies, a memory for your repairs, a better handle on everyday life. Small, thoughtful apps from Quiet Tools.</p><div class="hero-actions"><Button href={`${base}apps/`}>Find your next useful app <span aria-hidden="true">↗</span></Button><a class="text-link" href={`${base}about/`}>Meet Quiet Tools</a></div><div class="hero-app-icons" aria-label="Six apps from Quiet Tools">{apps.map(app => <a href={app.websiteUrl} aria-label={app.name}><img src={`${base}${app.image}`} alt="" width="40" height="40" /></a>)}<span>Built for the details<br />worth keeping.</span></div></div>
  <a class="hero-showcase" href={`${base}hobby-tracker/`}><div class="showcase-label"><span>Make time. Keep the memory.</span><span class="badge">Hobby Tracker</span></div><div class="showcase-screens"><img class="screen-main" src={`${base}assets/optimized/hero-hobby-mix.webp`} srcset={`${base}assets/optimized/hero-hobby-mix-320.webp 320w, ${base}assets/optimized/hero-hobby-mix-480.webp 480w, ${base}assets/optimized/hero-hobby-mix.webp 720w`} sizes="(max-width: 700px) 190px, 250px" width="720" height="1565" alt="Hobby Tracker shows the activities you made time for in a colorful Hobby Mix." fetchpriority="high" /><img class="screen-side" src={`${base}assets/optimized/month.webp`} srcset={`${base}assets/optimized/month-320.webp 320w, ${base}assets/optimized/month-480.webp 480w, ${base}assets/optimized/month.webp 720w`} sizes="(max-width: 700px) 190px, 250px" width="720" height="1565" alt="Monthly hobby activity calendar." /></div><div class="showcase-caption"><span>A record of what you enjoy.</span><span aria-hidden="true">↗</span></div></a>
</section>
