---
import Button from './Button.astro';
const base = import.meta.env.BASE_URL;
---
<section class="hero-shell" aria-labelledby="home-hero-title">
  <div class="hero section-pad">
    <div class="hero-copy">
      <p class="eyebrow">Simple apps for useful things.</p>
      <h1 id="home-hero-title">Simple apps for useful things.</h1>
      <p class="hero-subtitle">Quiet Tools builds calm, practical apps for everyday planning, tracking, maintenance, and shared moments.</p>
      <div class="hero-actions">
        <Button href={`${base}apps/`}>View our apps</Button>
        <Button href={`${base}support/`} variant="secondary">Get support</Button>
      </div>
      <p class="quiet-line"><span>✧</span> Independent app studio. Built quietly. Used practically.</p>
    </div>

    <div class="hero-art" aria-hidden="true" style={`--hero-art:url('${base}assets/hero-illustration.png')`}></div>
  </div>
</section>
