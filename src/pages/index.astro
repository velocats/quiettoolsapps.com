---
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
import AppGrid from '../components/AppGrid.astro';
import { apps } from '../data/apps';
---
<Layout><Hero />
<section class="section-pad collection" id="apps"><div class="section-heading"><div><p class="section-eyebrow">The collection</p><h2>A useful place for<br />everyday things.</h2></div><p>{apps.length} focused apps, including Cast Your Line, our fishing journal. Each one starts with a real problem and gives you a simpler way to handle it.</p></div><AppGrid /></section>
<section class="section-pad"><div class="studio-band"><p class="section-eyebrow">The Quiet Tools approach</p><h2>Life is full enough.<br />Your apps can be simpler.</h2><div class="studio-bottom"><p>We build practical software for the things you care about. Clear records, helpful reminders, and room to make it your own.</p><a class="button button-secondary" href="/about/">About the studio <span aria-hidden="true">↗</span></a></div></div></section>
<section class="section-pad choice-section"><div><p class="section-eyebrow">Home, business, or homestead?</p><h2>Find the right home<br />for your records.</h2></div><div><p>Keeping a furnace warranty is different from running a workshop or planning seasonal chores. See how our three maintenance and property apps fit.</p><a class="text-link" href="/compare-maintenance-apps/">Compare the maintenance apps <span aria-hidden="true">↗</span></a></div></section>
</Layout>
