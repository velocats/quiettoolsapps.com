---
import Layout from '../components/Layout.astro';
import AppGrid from '../components/AppGrid.astro';
import CalmBackground from '../components/CalmBackground.astro';
---
<Layout title="Explore Quiet Tools Apps — Hobbies, Maintenance, Meals & Travel" description="A growing collection of calm, practical apps from Quiet Tools.">
  <CalmBackground />
  <section class="page-hero">
    <p class="section-eyebrow">Apps</p>
    <h1>Small apps. Useful possibilities.</h1>
    <p>Quiet Tools apps are built for useful everyday moments: remembering the details about your home, knowing what meals cost, making road trips more fun, keeping maintenance records, and managing a busy homestead.</p>
  </section>
  <section class="section-pad" style="padding-top:0;">
    <h2 class="sr-only">All Quiet Tools apps</h2>
    <AppGrid />
  </section>
</Layout>
