---
import Layout from '../components/Layout.astro';
import AppGrid from '../components/AppGrid.astro';
import CalmBackground from '../components/CalmBackground.astro';
---
<Layout title="Explore Quiet Tools Apps — Hobbies, Fishing & Everyday Life" description="Explore Quiet Tools apps for hobbies, fishing, maintenance, meals, road trips, and homesteads. Cast Your Line is coming soon to the App Store.">
  <CalmBackground />
  <section class="page-hero">
    <p class="section-eyebrow">Apps</p>
    <h1>Small apps. Useful possibilities.</h1>
    <p>Quiet Tools apps are built for useful everyday moments: recording your hobbies and fishing trips, remembering the details about your home, knowing what meals cost, making road trips more fun, keeping maintenance records, and managing a busy homestead.</p>
  </section>
  <section class="section-pad" style="padding-top:0;">
    <h2 class="sr-only">All Quiet Tools apps</h2>
    <AppGrid />
  </section>
</Layout>
